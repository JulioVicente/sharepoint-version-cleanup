{
  "SchemaVersion": 2,
  "Tenant": "contoso.onmicrosoft.com",
  "AdminUrl": "https://contoso-admin.sharepoint.com",
  "Sites": [
    "https://contoso.sharepoint.com/sites/piloto"
  ],
  "FolderScopes": {
    "https://contoso.sharepoint.com/sites/piloto": "/sites/piloto/Documentos Compartilhados/Teste"
  },
  "VersionsToKeep": 10,
  "Authentication": {
    "ClientId": "11111111-1111-1111-1111-111111111111",
    "CertificateThumbprint": "0123456789ABCDEF0123456789ABCDEF01234567"
  },
  "Email": {
    "Enabled": false,
    "Provider": "Graph",
    "From": "operacao@contoso.com",
    "SenderUserId": "22222222-2222-2222-2222-222222222222",
    "To": [
      "operacao@contoso.com"
    ]
  },
  "Schedule": {
    "Frequency": "semanal",
    "Time": "22:00"
  },
  "Paths": {
    "State": "C:\\ProgramData\\SharePointVersionCleanup\\state",
    "Logs": "C:\\ProgramData\\SharePointVersionCleanup\\logs"
  },
  "Safety": {
    "MaxVersionsPerRun": 1000,
    "MinimumVersionAgeDays": 30
  },
  "Retry": {
    "MaxDelaySeconds": 60,
    "MaxRetries": 5,
    "BaseDelaySeconds": 2
  },
  "Audit": {
    "CopyDirectory": ""
  },
  "Sampling": {
    "RecencyWeight": 4,
    "SizeWeight": 1,
    "RecencyHalfLifeDays": 30,
    "Enabled": true,
    "SamplesPerLibrary": 1
  }
}
